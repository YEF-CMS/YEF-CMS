{
    "name": "yef-cms/yef-cms",
    "type": "project",
    "description": "YEF CMS (Yet another file CMS): a database-less PHP CMS that generates static HTML on every content change.",
    "keywords": [
        "cms",
        "static-site",
        "flat-file",
        "yii3"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/YEF-CMS/YEF-CMS",
    "support": {
        "issues": "https://github.com/YEF-CMS/YEF-CMS/issues",
        "source": "https://github.com/YEF-CMS/YEF-CMS"
    },
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "composer/semver": "^3.4",
        "httpsoft/http-message": "^1.1.6",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0.2",
        "symfony/console": "^7.4.7 || ^8.0.7",
        "symfony/uid": "^8.1",
        "twig/twig": "^3.30",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/auth": "^3.3",
        "yiisoft/cache-file": "^3.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/log": "^2.2.0",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/rate-limiter": "^3.0",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/security": "^1.2",
        "yiisoft/session": "^3.0",
        "yiisoft/translator": "^3.2",
        "yiisoft/translator-message-php": "^1.1",
        "yiisoft/user": "^2.3",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "phpunit/phpunit": "^11.5.55",
        "psr/event-dispatcher": "^1.0",
        "rector/rector": "^2.3.9",
        "roave/security-advisories": "dev-latest",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Yef\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yef\\Tests\\": "tests/",
            "YefCms\\TextPages\\": "modules/yef-cms__text/src/"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "psalm": "psalm --no-cache",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run --no-progress-bar",
        "rector:fix": "rector process --no-progress-bar",
        "deptrac": "deptrac analyse --no-progress",
        "deps": "composer-dependency-analyser",
        "validate:composer": "@composer validate --strict",
        "security": "@composer audit",
        "fix": [
            "@rector:fix",
            "@cs:fix"
        ],
        "qa": [
            "@validate:composer",
            "@rector",
            "@cs",
            "@psalm",
            "@deptrac",
            "@deps",
            "@security",
            "@test"
        ]
    }
}
