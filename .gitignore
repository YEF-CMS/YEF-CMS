# Dependencies
/vendor/

# Runtime data (caches, logs, locks)
/var/*
!/var/.gitkeep

# Tooling caches
/.phpunit.result.cache
/.php-cs-fixer.cache

# IDE
/.idea/
/.vscode/

# OS
.DS_Store
Thumbs.db

# Local overrides
/docker-compose.override.yml
/.env

# Tooling caches
/.deptrac.cache

# Site content (the owner's data, not part of the code)
/content/

# Internal data that cannot be recreated: users and, later, roles and settings
/data/

# Generated site: pages are published here, only the entry points are code
/public/*
!/public/admin/
