{% extends 'base.twig' %}

{% block title %}{% block page_title %}{% endblock %} · {{ t('app.name') }}{% endblock %}

{% block body_class %}yef-admin{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark yef-topbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ url('admin.dashboard') }}">{{ t('app.name') }}</a>
        <div class="d-flex align-items-center gap-3">
            <form method="post" action="{{ url('admin.language') }}" class="m-0 yef-language">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <label class="visually-hidden" for="language">{{ t('nav.language') }}</label>
                <select class="form-select form-select-sm" id="language" name="language">
                    {% for code, name in languages %}
                        <option value="{{ code }}"{{ code == language ? ' selected' : '' }}>{{ name }}</option>
                    {% endfor %}
                </select>
                <noscript><button type="submit" class="btn btn-outline-light btn-sm">{{ t('nav.language_apply') }}</button></noscript>
            </form>
            <form method="post" action="{{ url('admin.logout') }}" class="d-flex align-items-center gap-3 m-0">
                <span class="navbar-text">{{ t('nav.signed_in_as', {login: login}) }}</span>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button type="submit" class="btn btn-outline-light btn-sm">{{ t('nav.logout') }}</button>
            </form>
        </div>
    </div>
</nav>
<div class="yef-shell">
    <aside class="yef-sidebar border-end bg-body-tertiary">
        <ul class="nav nav-pills flex-column p-3 gap-1">
            <li class="nav-item">
                <a class="nav-link {% block nav_dashboard %}{% endblock %}" href="{{ url('admin.dashboard') }}">{{ t('nav.dashboard') }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% block nav_pages %}{% endblock %}" href="{{ url('admin.pages') }}">{{ t('nav.pages') }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% block nav_modules %}{% endblock %}" href="{{ url('admin.modules') }}">{{ t('nav.modules') }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% block nav_apply %}{% endblock %}" href="{{ url('admin.apply') }}">{{ t('nav.apply') }}</a>
            </li>
        </ul>
    </aside>
    <main class="yef-content p-4">
        {% for kind, message in flash %}
            <div class="alert alert-{{ kind }} alert-dismissible fade show" role="alert">
                {{ t(message) }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ t('common.close') }}"></button>
            </div>
        {% endfor %}
        {% block content %}{% endblock %}
    </main>
</div>
<script src="{{ assetsUrl }}/language.js"></script>
{% endblock %}
